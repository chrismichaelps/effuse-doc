{
  "name": "@effuse/app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Effuse documentation website",
  "author": "Chris M. P\u00e9rez",
  "license": "MIT",
  "scripts": {
    "server:registry": "node scripts/generate-server-registry.mjs",
    "dev": "pnpm server:registry && vite",
    "build": "pnpm server:registry && tsc --noEmit && pnpm build:client && pnpm build:server",
    "preview": "node scripts/serve.mjs",
    "typecheck": "pnpm server:registry && tsc --noEmit",
    "test": "pnpm server:registry && vitest run --passWithNoTests",
    "test:watch": "pnpm server:registry && vitest",
    "docs:next-steps": "node scripts/docs-next-steps.mjs",
    "docs:next-steps:write": "node scripts/docs-next-steps.mjs --write",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.ts"
  },
  "dependencies": {
    "@effuse/core": "2.1.0",
    "@effuse/i18n": "1.1.4",
    "@effuse/ink": "1.2.4",
    "@effuse/query": "2.0.4",
    "@effuse/router": "1.2.4",
    "@effuse/server": "1.0.4",
    "@effuse/store": "1.1.4",
    "@effuse/use": "1.2.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effuse/cli": "1.0.4",
    "@effuse/compiler": "1.0.6",
    "@rolldown/binding-darwin-x64": "1.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.32.1"
}
